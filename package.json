{
  "name": "xxkatt-utils",
  "private": true,
  "scripts": {
    "docs:dev": "pnpm --filter @xxkatt/docs run dev",
    "docs:build": "pnpm --filter @xxkatt/docs run build",
    "docs:preview": "pnpm --filter @xxkatt/docs run preview",
    "build": "pnpm --filter @xxkatt/utils run build",
    "typecheck": "pnpm --filter @xxkatt/utils run typecheck",
    "test": "pnpm --filter @xxkatt/utils run test",
    "test:watch": "pnpm --filter @xxkatt/utils run test:watch",
    "clean": "pnpm --filter @xxkatt/utils run clean",
    "lint": "oxlint --deny-warnings packages/js",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.24.0"
}
