{
  "name": "@xxkatt/utils",
  "version": "0.0.1",
  "description": "常用的 JavaScript / TypeScript 工具函数",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxkatt/xxkatt-utils.git",
    "directory": "packages/js/utils"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  }
}
